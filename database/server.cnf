# ==============================================================================
# L2JLucera2 - MariaDB 10.11+ High-Concurrency Server Configuration
# Alvo: ~2.000 Jogadores Online Simultâneos (SSD NVMe / 32GB RAM dedicada)
# Local padrão no Linux: /etc/mysql/mariadb.conf.d/50-server.cnf ou /etc/my.cnf.d/
# ==============================================================================

[mysqld]
# --- Conexões e Rede ---
user                            = mysql
port                            = 3306
bind-address                    = 127.0.0.1
back_log                        = 1024
max_connections                 = 400
max_connect_errors              = 1000000
wait_timeout                    = 600
interactive_timeout             = 600

# --- Charset e Collation ---
character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci

# --- Engine Padrão ---
default_storage_engine          = InnoDB
default_tmp_storage_engine      = InnoDB

# ==============================================================================
# INNODB CORE TUNING (Zero-Contention / High Throughput)
# ==============================================================================

# Buffer Pool: dimensionado para ~70-75% da RAM dedicada
innodb_buffer_pool_size         = 24G
innodb_buffer_pool_instances     = 16
innodb_buffer_pool_dump_at_shutdown = 1
innodb_buffer_pool_load_at_startup  = 1

# Transações e Durabilidade: Modo 2 (Flush a cada 1s pelo SO)
innodb_flush_log_at_trx_commit  = 2

# Bypass do Page Cache do SO para evitar double-buffering
innodb_flush_method             = O_DIRECT

# Redo Log (MariaDB 10.11+ usa innodb_redo_log_capacity)
innodb_redo_log_capacity        = 4G
innodb_log_buffer_size          = 64M

# Calibração de I/O para SSDs NVMe Corporativos
innodb_io_capacity              = 10000
innodb_io_capacity_max          = 25000
innodb_flush_neighbors          = 0
innodb_page_cleaners            = 8

# Concorrência e Locks
innodb_autoinc_lock_mode        = 2
innodb_lock_wait_timeout        = 10
innodb_deadlock_detect          = ON
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8

# ==============================================================================
# MEMÓRIA TEMPORÁRIA E CACHES
# ==============================================================================
tmp_table_size                  = 256M
max_heap_table_size             = 256M
join_buffer_size                = 8M
sort_buffer_size                = 4M
read_rnd_buffer_size            = 2M
table_open_cache                = 8192
table_open_cache_instances      = 16

# Desativar Query Cache
query_cache_type                = 0
query_cache_size                = 0
