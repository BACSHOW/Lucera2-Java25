  "routines": [
    {
      "name": "lip_AccountCreate",
      "type": "PROCEDURE",
      "definition": "BEGIN\n    INSERT LOW_PRIORITY INTO `accounts` (\n        `login`,\n        `password`\n    ) VALUES (\n        sAccountName,\n        sAccountPasswordHash\n    );\nEND",
      "isDeterministic": false,
      "securityType": "DEFINER",
      "comment": "",
      "parameters": [
        {
          "name": "sAccountName",
          "mode": "IN",
          "type": "varchar(32)"
        },
        {
          "name": "sAccountPasswordHash",
          "mode": "IN",
          "type": "varchar(255)"
        }
      ]
    },
    {
      "name": "lip_AccountLoad",
      "type": "PROCEDURE",
      "definition": "BEGIN\n    SELECT \n        `a`.`password` AS `password`, \n        `a`.`accessLevel` AS `accessLevel`, \n        `a`.`lastServerId` AS `lastServerId`, \n        `a`.`lastIP` AS `lastIP`, \n        `a`.`lastactive` AS `lastactive`, \n        `a`.`l2email` AS `email`\n    FROM \n        `accounts` `a` \n    WHERE \n        `a`.`login` \u003d sAccountName;\nEND",
      "isDeterministic": false,
      "securityType": "DEFINER",
      "comment": "",
      "parameters": [
        {
          "name": "sAccountName",
          "mode": "IN",
          "type": "varchar(32)"
        }
      ]
    },
    {
      "name": "lip_AccountUpdate",
      "type": "PROCEDURE",
      "definition": "BEGIN\n    UPDATE LOW_PRIORITY \n        `accounts` \n    SET\n        `password` \u003d sAccountPasswordHash,\n        `accessLevel` \u003d iAccessLevel,\n        `lastServerId` \u003d iLastServerId,\n        `lastIP` \u003d sLastIp,\n        `lastactive` \u003d iLastActive,\n        `l2email` \u003d sEmail\n    WHERE\n        `login` \u003d sAccountName\n    LIMIT 1;\nEND",
      "isDeterministic": false,
      "securityType": "DEFINER",
      "comment": "",
      "parameters": [
        {
          "name": "sAccountName",
          "mode": "IN",
          "type": "varchar(32)"
        },
        {
          "name": "sAccountPasswordHash",
          "mode": "IN",
          "type": "varchar(255)"
        },
        {
          "name": "iAccessLevel",
          "mode": "IN",
          "type": "tinyint(6)"
        },
        {
          "name": "iLastServerId",
          "mode": "IN",
          "type": "int(4)"
        },
        {
          "name": "sLastIp",
          "mode": "IN",
          "type": "varchar(15)"
        },
        {
          "name": "iLastActive",
          "mode": "IN",
          "type": "int(11)"
        },
        {
          "name": "sEmail",
          "mode": "IN",
          "type": "varchar(45)"
        }
      ]
    }
